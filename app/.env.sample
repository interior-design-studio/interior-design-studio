# Django
SECRET_KEY=<your-secret-key>
DEBUG=True

# Hosts
ALLOWED_HOSTS=127.0.0.1,localhost,<your-domain>
CSRF_TRUSTED_ORIGINS=https://<your-domain>

# CORS
CORS_ALLOWED_ORIGINS=https://<your-domain>
CORS_ALLOW_CREDENTIALS=True/False

# HTTPS
HTTPS=False
SECURE_SSL_REDIRECT=True/False  # nginx-proxy usually handles redirects
SECURE_HSTS_SECONDS=0/3600
USE_X_FORWARDED_HOST=True/False
USE_X_FORWARDED_PORT=True/False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Gmail
EMAIL_HOST_USER=<your-email@gmail.com>
EMAIL_HOST_PASSWORD=<your-app-password>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
ADMIN_NOTIFICATION_EMAIL=<admin-email@example.com>

# DB
POSTGRES_USER=<your-db-user>
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=<your-db-name>
POSTGRES_HOST=db
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
